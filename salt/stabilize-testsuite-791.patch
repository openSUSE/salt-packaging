         # Run with test=True
         ret = _run(test=True)
-        assert ret.changes == {"repo": name.format(arch="")}
+        assert ret.changes == {"repo": name.format(arch=_get_arch(""))}
         assert "would be" in ret.comment
         assert ret.result is None
 
     with subtests.test("test=False"):
         # Run for real
         ret = _run()
